generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TradeStatus {
  OPENED
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ProposalItemType {
  OFFERED
  REQUESTED
}

enum WishlistItemType {
  SPECIFIC_CARD
  FILTER
}

enum TradeItemType {
  OFFERED
  REQUESTED
}

model Trade {
  id          String      @id @default(uuid())
  createdBy   String
  acceptedBy  String?
  status      TradeStatus @default(OPENED)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items          TradeItem[]
  tradeProposals TradeProposal[]

  @@index([createdBy])
  @@index([acceptedBy])
}

model TradeItem {
  id         String        @id @default(uuid())
  tradeId    String
  cardId     String?
  quantity   Int
  wishlistId String?
  type       TradeItemType

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([tradeId, type])
}

model TradeProposal {
  id         String         @id @default(uuid())
  proposerId String
  tradeId    String
  message    String?
  status     ProposalStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items ProposalItem[]
  trade Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([proposerId])
  @@index([tradeId])
  @@index([tradeId, proposerId])
}

model ProposalItem {
  id         String           @id @default(uuid())
  proposalId String
  cardId     String
  quantity   Int
  type       ProposalItemType

  proposal TradeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id           String           @id @default(uuid())
  wishlistId   String
  itemType     WishlistItemType
  cardId       String?
  filterType   String?
  filterRarity String?

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([wishlistId])
  @@index([wishlistId, itemType])
}
